EVAGG_DATABASE_URL=postgresql+asyncpg://evagg_app:evagg_app@localhost:5432/evagg
EVAGG_SUPERADMIN_DATABASE_URL=postgresql+asyncpg://evagg_superadmin:evagg_superadmin@localhost:5432/evagg
EVAGG_MIGRATION_DATABASE_URL=postgresql+asyncpg://evagg:evagg@localhost:5432/evagg
EVAGG_REDIS_URL=redis://localhost:6379/0
EVAGG_NATS_URL=nats://localhost:4222

# persistence_backend=memory (default) keeps every domain store in-process.
# Set to supabase to back the OCPP core + billing with real PostgREST calls
# instead — see docs/supabase/schema.sql and docs/production_readiness.md.
EVAGG_PERSISTENCE_BACKEND=memory
EVAGG_SUPABASE_URL=https://project.supabase.co
EVAGG_SUPABASE_API_KEY=dev_only_replace_me
